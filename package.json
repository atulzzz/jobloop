{
  "name": "jobloop",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first AI job search workbench.",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test electron/validation.test.mjs",
    "check": "npm run test && npm run build && node scripts/smoke.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^34.5.8",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
